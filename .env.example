# Optional. Rules-only and offline demo modes work without an API key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional project-level Google OAuth connections.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8042/oauth/google/callback

# Or read the OAuth client identity from existing authorized-user profiles.
# Refresh tokens in these source files are never reused by LocalLift.
GOOGLE_GBP_OAUTH_PROFILE_FILE=
GOOGLE_GSC_OAUTH_PROFILE_FILE=
GOOGLE_GA4_OAUTH_PROFILE_FILE=
GOOGLE_OAUTH_PROFILE_REDIRECT_URI=http://localhost:8042

# Optional standalone Semrush keyword research and volume monitoring.
# Keyword Metrics currently consumes 20 Semrush API units per keyword.
SEMRUSH_API_KEY=

# Server settings
LOCALLIFT_HOST=127.0.0.1
LOCALLIFT_PORT=8042
LOCALLIFT_DATA_DIR=.data
